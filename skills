#!/usr/bin/bash
set -u

USAGE_MSG="
Usage:
	$0 [ [0|-|+|*] | [-h|-c] ]

# sem parametros lista tudo
# -h 		mostra essa mensagem
# -c 		mostra s'o as categorias
# -c=CATEG	Lista as skills por categ
#
# 0 	filtra as skills que preciso aprender
# - 	filtra as skills que sei como funciona mas preciso melhorar
# + 	filtra as skills que ja sei me virar sozinho
# '*' 	filtra as skills que domino
"


dbname="${0}.txt"
skill_type=""



function usage(){
	local exit_status=${1:-0}
	local output=1

	if [ "${exit_status}" -ne 0 ]; then
		output=2
	fi
	echo -e "${USAGE_MSG}" >&"${output}"
	exit $exit_status
}



function categs() {
	grep '{*}' ${dbname} | tr -d '{}'
	exit 0
}



function sh_categ_block() {
	awk "/{{ $1/,/---/" "${dbname}" | sed 's:---:\n:' | tr -d '{}'
	exit 0
}



if [ $# -gt 1 ]; then
	usage 2

elif [ $# -eq 1 ]; then
	case $1 in 
		-h) usage;;
		'0' | '-' | '+' | '*')
			skill_type=$1
			;;
		-c) categs ;;
		-c=*) sh_categ_block "${1:3}";;
		*) usage 2;;
	esac
fi




if [ -z "$skill_type" ]; then
	tr -d '{}' <<< "$(<$dbname)"
	exit 0
fi



grep -F "[${skill_type}]" "$dbname"


