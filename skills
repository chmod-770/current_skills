#!/usr/bin/bash
set -u

USAGE_MSG="
Usage:
	$0 [ [0-5] | [-h|-c] ]

# sem parametros lista tudo
# -h 		mostra essa mensagem
# -c 		lista as CATEGs
# -c=CATEG	Lista as skills por CATEG
#
# 0 	-> preciso aprender
# 1 	-> ja ouvi falar ou usei uma vez ou outra
# 2 	-> sei usar o basico
# 3	-> se acabar a internet, eu nao fico travado...
# 4 	-> me de um problema e a doc que te darei uma solucao
# 5 	-> O pai 'e mostro fio, iXquece fio
"


dbname="${0}.txt"
skill_type=""


function usage(){
	local exit_status=${1:-0}
	local output=1

	[ "${exit_status}" -ne 0 ] && output=2

	echo -e "${USAGE_MSG}" >&"${output}"
	exit $exit_status
}



function categs() {
	grep '{*}' ${dbname} | tr -d '{}'
	exit 0
}



function categ_content() {
	awk "/{{ $1/,/---/" "${dbname}" | sed 's:---:\n:' | tr -d '{}'
	exit 0
}



if [ $# -gt 1 ]; then
	usage 2

elif [ $# -eq 1 ]; then
	case $1 in 
		[0-5])skill_type=$1;;
		-h) usage;;
		-c) categs ;;
		-c=*) categ_content "${1:3}";;
		*) usage 2;;
	esac
fi




if [ -z "$skill_type" ]; then
	tr -d '{}' <<< "$(<$dbname)" | less
	exit
fi



grep -F "[${skill_type}]" "$dbname" | less
exit

